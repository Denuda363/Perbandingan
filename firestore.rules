rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow read and write to products collection for real-time collaborative price comparisons
    match /products/{productId} {
      allow read, write: if true;
    }

    // Allow read and write to suppliers collection
    match /suppliers/{supplierId} {
      allow read, write: if true;
    }

    // Allow read and write to settings collection for app configuration (PPN, margin)
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Health check / connection test
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
